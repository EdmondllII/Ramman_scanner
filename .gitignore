# Python 缓存与构建产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
*.whl
build/
dist/
pip-wheel-metadata/

# 测试、类型检查与代码质量工具缓存
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# 文档构建产物
_build/

# 项目运行结果与临时文件
raman_output/
raman_preprocessed/
raman_peaks/
outputs/
tmp/
work/*/output/**
!work/*/output/.gitkeep

# 本地数据（通常体积较大或包含实验原始数据）
data/raw/
data/processed/

# 虚拟环境与本地配置
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# 编辑器与操作系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Jupyter 临时目录与运行日志
.ipynb_checkpoints/
*.log
